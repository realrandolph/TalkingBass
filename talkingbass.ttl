@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix midi: <http://lv2plug.in/ns/ext/midi#> .
@prefix urid: <http://lv2plug.in/ns/ext/urid#> .

<https://opencode.local/lv2/talkingbass>
	a lv2:Plugin, lv2:InstrumentPlugin ;
	doap:name "Talking Bass" ;
	lv2:optionalFeature lv2:hardRTCapable ;
	lv2:requiredFeature urid:map ;
	rdfs:comment "MIDI talking/ram bass: saw+sub body, split-band formants." ;
	lv2:port [
		a lv2:OutputPort, lv2:AudioPort ;
		lv2:index 0 ; lv2:symbol "out_l" ; lv2:name "Out L"
	] , [
		a lv2:OutputPort, lv2:AudioPort ;
		lv2:index 1 ; lv2:symbol "out_r" ; lv2:name "Out R"
	] , [
		a lv2:InputPort, atom:AtomPort ;
		lv2:index 2 ; lv2:symbol "midi" ; lv2:name "MIDI" ;
		atom:bufferType atom:Sequence ;
		atom:supports midi:MidiEvent
	] , [
		a lv2:InputPort, lv2:ControlPort ;
		lv2:index 3 ; lv2:symbol "vowel" ; lv2:name "Vowel" ;
		lv2:default 0.18 ; lv2:minimum 0.0 ; lv2:maximum 1.0
	] , [
		a lv2:InputPort, lv2:ControlPort ;
		lv2:index 4 ; lv2:symbol "lfo_hz" ; lv2:name "LFO Rate" ;
		lv2:default 3.4 ; lv2:minimum 0.1 ; lv2:maximum 20.0 ;
		units:unit units:hz
	] , [
		a lv2:InputPort, lv2:ControlPort ;
		lv2:index 5 ; lv2:symbol "lfo_amt" ; lv2:name "LFO Amount" ;
		lv2:default 0.28 ; lv2:minimum 0.0 ; lv2:maximum 1.0
	] , [
		a lv2:InputPort, lv2:ControlPort ;
		lv2:index 6 ; lv2:symbol "split_hz" ; lv2:name "Sub Split" ;
		lv2:default 128.0 ; lv2:minimum 40.0 ; lv2:maximum 250.0 ;
		units:unit units:hz
	] , [
		a lv2:InputPort, lv2:ControlPort ;
		lv2:index 7 ; lv2:symbol "drive" ; lv2:name "Drive" ;
		lv2:default 0.36 ; lv2:minimum 0.0 ; lv2:maximum 1.0
	] , [
		a lv2:InputPort, lv2:ControlPort ;
		lv2:index 8 ; lv2:symbol "mix" ; lv2:name "Mix" ;
		lv2:default 1.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
	] , [
		a lv2:InputPort, lv2:ControlPort ;
		lv2:index 9 ; lv2:symbol "body" ; lv2:name "Body" ;
		lv2:default 0.78 ; lv2:minimum 0.0 ; lv2:maximum 1.0
	] .

<https://opencode.local/lv2/talkingbass#growl>
