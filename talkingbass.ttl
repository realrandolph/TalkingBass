	] , [
		a lv2:InputPort, lv2:ControlPort ;
		lv2:index 9 ; lv2:symbol "body" ; lv2:name "Body" ;
		lv2:default 0.70 ; lv2:minimum 0.0 ; lv2:maximum 1.0
	] .

